const express = require("express");
const app = express();

app.use(express.json());

let users = [];

app.get("/", (req, res) => {
  res.send("Backend running ✅");
});

app.post("/register", (req, res) => {
  const user = req.body;
  users.push(user);
  res.json({ success: true });
});

app.listen(3000, () => {
  console.log("Server running on port 3000");
});